    },
    "uid": {
      "type": "string"
    },
    "nickname": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "region": {
      "type": "string",
      "enum": [
        "domestic",
        "international"
      ]
    }
  },
  "additionalProperties": false
