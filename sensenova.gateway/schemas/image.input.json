{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "description": "图像描述，越具体越好；信息图类内容把标题与文字直接写进 prompt。"
    },
    "model": {
      "type": "string",
      "enum": ["sensenova-u1.5-lite", "sensenova-u1.5-fast", "sensenova-u1-fast"],
      "description": "生图模型。默认取插件配置里的默认模型（sensenova-u1.5-lite）。"
    },
    "size": {
      "type": "string",
      "description": "尺寸，如 1024x1024、2048x2048、2752x1536。U1.5 系列按 32 倍数与 512–4096 范围吸附，U1 Fast 吸附到官方 11 档。"
    }
  },
  "required": ["prompt"],
  "additionalProperties": false
}